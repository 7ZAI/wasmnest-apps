{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "mocha"],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": [
    "wdio.conf.ts",
    "wdio.dual.conf.ts",
    "harness/**/*.ts",
    "pages/**/*.ts",
    "specs/**/*.ts",
    "dual/**/*.ts"
  ]
}
