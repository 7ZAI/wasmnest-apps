{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@binblink/wasmnest-plugin-sdk-desktop": ["../../../../wasmnest/wasmnest-desktop/packages/plugin-sdk-desktop/src/index.ts"],
      "@binblink/wasmnest-plugin-sdk-desktop/vite": ["../../../../wasmnest/wasmnest-desktop/packages/plugin-sdk-desktop/src/vite-plugin.ts"],
      "@binblink/wasmnest-plugin-sdk-desktop/types": ["../../../../wasmnest/wasmnest-desktop/packages/plugin-sdk-desktop/src/types.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["node_modules", "rust"]
}
