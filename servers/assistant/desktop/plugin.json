{
  "id": "com.wasmnest.assistant",
  "name": "Nest",
  "version": "0.0.1",
  "platform": "desktop",
  "update": {
    "provider": "github-release"
  },
  "description": "系统级个人助手：情感陪伴对话 + 应用调度执行。独立于 BedCode；本地记忆与密钥保险库；工具按风险分级确认。",
  "author": "WasmNest",
  "main": "index.js",
  "pluginType": "full",
  "type": "internal-business",
  "rustLibrary": "wasmnest_plugin_assistant",
  "icon": "icon.svg",
  "permissions": [
    "apps:control",
    "storage",
    "ui:globalEntry"
  ],
  "contributes": {
    "commands": [
      {
        "id": "assistant.ping",
        "title": "Assistant: Ping"
      }
    ],
    "globalEntries": [
      {
        "id": "nest",
        "title": "Nest",
        "icon": "icon.svg",
        "order": 10
      }
    ]
  }
}
