{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@binblink/wasmnest-plugin-sdk-mobile": ["../../../../wasmnest/wasmnest-mobile/packages/plugin-sdk-mobile/src/index.ts"],
      "@binblink/wasmnest-plugin-sdk-mobile/vite": ["../../../../wasmnest/wasmnest-mobile/packages/plugin-sdk-mobile/src/vite-plugin.ts"],
      "@binblink/wasmnest-plugin-sdk-mobile/types": ["../../../../wasmnest/wasmnest-mobile/packages/plugin-sdk-mobile/src/types.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["node_modules", "rust"]
}
