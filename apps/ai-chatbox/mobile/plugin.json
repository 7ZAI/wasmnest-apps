{
  "id": "com.wasmnest.ai-chatbox",
  "name": "AI Chatbox",
  "version": "0.0.1",
  "platform": "mobile",
  "description": "AI 大模型对话：支持 OpenAI 兼容 / Anthropic / Gemini 多供应商\n· 多供应商管理：Base URL、API Key、模型均可配置\n· 流式输出，思考模式与推理强度可调\n· 会话管理：历史会话保存、恢复、删除\n· 对话日志 JSONL 落盘，可追溯审计\n使用：在宿主壳应用列表打开「AI Chatbox」独立页面；首次使用先在应用内配置供应商与模型，随后即可开始聊天。",
  "author": "WasmNest",
  "icon": "icon.svg",
  "main": "index.js",
  "pluginType": "wasm",
  "rustLibrary": "wasmnest_plugin_ai_chatbox",
  "preauthDirs": ["${downloads}/ai-chatbox"],
  "preauthUrls": [
    "https://api.deepseek.com/*",
    "https://dashscope.aliyuncs.com/*",
    "https://*.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "permissions": ["fs:read", "fs:write", "network:http", "storage", "ui:back"],
  "contributes": {
    "commands": [
      {
        "id": "ai-chatbox.chat-stream",
        "title": "Chat Stream"
      },
      {
        "id": "ai-chatbox.chat-complete",
        "title": "Chat Complete"
      },
      {
        "id": "ai-chatbox.fetch-models",
        "title": "Fetch Models"
      },
      {
        "id": "ai-chatbox.list-conversations",
        "title": "List Conversations"
      },
      {
        "id": "ai-chatbox.get-messages",
        "title": "Get Messages"
      },
      {
        "id": "ai-chatbox.save-conversation",
        "title": "Save Conversation"
      },
      {
        "id": "ai-chatbox.save-message",
        "title": "Save Message"
      },
      {
        "id": "ai-chatbox.delete-conversation",
        "title": "Delete Conversation"
      }
    ]
  }
}
