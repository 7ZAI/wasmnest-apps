{
  "id": "com.wasmnest.news",
  "name": "News",
  "version": "0.0.1",
  "platform": "both",
  "update": { "provider": "github-release" },
  "description": "个人新闻聚合：按源与圈子汇集 24 小时内的信息条。\n使用：侧边栏「新闻」→ 今日 / 圈子 / 实时 / 收藏四段切换 → 点卡片看摘要与来源。",
  "author": "WasmNest",
  "main": "index.js",
  "pluginType": "full",
  "rustLibrary": "wasmnest_plugin_news",
  "icon": "icon.svg",
  "permissions": ["storage", "ui:sidebar"],
  "contributes": {
    "commands": [
      { "id": "news.list-feed", "title": "news.list-feed" },
      { "id": "news.list-circles", "title": "news.list-circles" },
      { "id": "news.list-sources", "title": "news.list-sources" },
      { "id": "news.get-settings", "title": "news.get-settings" },
      { "id": "news.refresh", "title": "Refresh News" }
    ],
    "configuration": {
      "title": "News Settings",
      "properties": {}
    }
  }
}