    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "terser": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.0",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vue": "^3.4.0",
    "vue-i18n": "^9.0.0",
    "tailwindcss": "^3.4.0",
    "autoprefixer": "^10.4.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.0.6",
    "happy-dom": "^13.6.0",
    "@vue/test-utils": "^2.4.5"
