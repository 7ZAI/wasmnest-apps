{
  "id": "com.wasmnest.agent-hub",
  "name": "Agent Hub",
  "version": "0.0.1",
  "platform": "desktop",
  "description": "Agent CLI 统一管理台：环境检测与一键安装/卸载、Skills 管理、供应商统一配置、使用统计与会话日志解析。\n使用：侧边栏「Agent Hub」→ 概览查看各 CLI 安装状态与环境，卡片上可一键卸载；安装与更新在「安装与更新」页操作；Skills 浏览/编辑/分发/GitHub 安装/本地导入在「Skills」页操作。",
  "author": "WasmNest",
  "main": "index.js",
  "pluginType": "full",
  "rustLibrary": "wasmnest_plugin_agent_hub",
  "icon": "icon.svg",
  "permissions": [
    "app:path",
    "broadcast",
    "fs:pick",
    "fs:read",
    "fs:write",
    "network:http",
    "process:run",
    "storage",
    "task:run",
    "ui:sidebar"
  ],
