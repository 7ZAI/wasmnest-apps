{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@/*": ["./src/*"],
      "@binblink/wasmnest-plugin-sdk-desktop": ["../../packages/plugin-sdk-desktop/src/index.ts"],
      "@binblink/wasmnest-plugin-sdk-desktop/vite": ["../../packages/plugin-sdk-desktop/src/vite-plugin.ts"],
      "@binblink/wasmnest-plugin-sdk-desktop/types": ["../../packages/plugin-sdk-desktop/src/types.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts"],
  "exclude": ["node_modules", "rust", "src/__tests__/**"]
}
