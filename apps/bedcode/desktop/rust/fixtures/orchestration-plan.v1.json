      "writeScope": ["apps/file-transfer/desktop/src/", "apps/file-transfer/desktop/rust/"],
      "acceptance": {
        "type": "command",
        "command": ["pnpm", "run", "test:run"],
        "cwd": "apps/file-transfer/desktop",
        "timeoutSec": 900
      },
      "maxAttempts": 2
    },
    {
      "key": "n2",
      "title": "独立评审",
      "role": "reviewer",
      "agentId": "opencode",
      "prompt": "只读评审 n1 的 diff，输出 PASS/FAIL 与理由。",
      "dependsOn": ["n1"],
      "writeScope": [],
      "acceptance": { "type": "verdict" },
      "maxAttempts": 1
    }
  ]
}
