{
  "id": "com.wasmnest.bedcode",
  "name": "BedCode",
  "version": "0.0.1",
  "platform": "desktop",
  "description": "BedCode 终端会话中心：会话配置与生命周期编排、任务队列与 Agent 集成。\n认证 / 配对 / 信任域已迁至 com.wasmnest.auth-center（issue #6）：设备配对、连接历史与就位状态在 BedCode 页面上保留，数据经互调消费认证中心；BedCode 不再注册为认证中心。\n使用：侧边栏「设备配对 / 连接历史 / 终端会话 / Agent任务」四目录；会话创建时自动安装项目 hooks 同步任务状态；终端工具栏按钮打开任务队列弹窗；设置页贡献分组管理配对码 TTL、QR 有效期与 hooks。",
  "author": "WasmNest",
  "main": "index.js",
  "type": "business-app",
  "pluginType": "rust-ts",
  "backgroundTransport": true,
  "rustLibrary": "bedcode_plugin_terminal_session",
  "icon": "icon.svg",
  "permissions": [
    "app:path",
    "auth",
    "broadcast",
    "connection:read",
    "fs:pick",
    "fs:read",
    "fs:write",
    "network:http",
    "peer",
    "process:run",
    "pty:io",
    "pty:spawn",
    "session:read",
    "storage",
    "task:run",
    "terminal:input",
    "timer:schedule",
    "ui:input",
    "ui:settings",
    "ui:sidebar",
    "ws:server"
  ],
  "dependencies": [
    "host-pty"
  ],
  "ptyQuota": 8,
  "api": [
    "com.wasmnest.bedcode.pairing-code-generate",
    "com.wasmnest.bedcode.pairing-code-status",
